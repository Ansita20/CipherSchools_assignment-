PORT=4000
NODE_ENV=development
DB_PATH=./data/app.sqlite

# Used by the LLMEvaluator (src/infrastructure/ai/ClaudeEvaluator.ts).
# Leave blank to run with deterministic-only evaluation.
ANTHROPIC_API_KEY=

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173
