PORT=4000
NODE_ENV=development
DB_PATH=./data/app.sqlite

# Signs learner session cookies. Has a dev-only fallback so `npm run dev`
# works with no setup, but set this to a long random value for anything
# beyond your own machine - openssl rand -hex 32 works.
JWT_SECRET=

# AI-assisted rubric scoring (backend/src/infrastructure/ai/). Set either
# key, both, or neither - leaving both blank still works, submissions just
# get the deterministic completeness feedback instead of rubric scores.
#
# If both are set, EVAL_PROVIDER picks which one runs ("anthropic" or
# "gemini"); leave it blank and whichever key is present wins (Anthropic
# first if both are).
ANTHROPIC_API_KEY=
EVAL_MODEL=claude-opus-5

GEMINI_API_KEY=
GEMINI_EVAL_MODEL=gemini-3.5-flash-lite

EVAL_PROVIDER=

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173
